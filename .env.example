# --- AI (required) ---
# fall back to the next if the first is down or out of credit:
#   AI_PROVIDER=openai,anthropic
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

VOICE_PROVIDER=openai

CLINIC_TIMEZONE=Asia/Taipei

# --- Security (required): You can add a random string for demo purpose ---
AUTH_SECRET=dev-only-insecure-secret-change-me

# --- Email  ---
# fill these in (with Gmail, SMTP_PASS must be an app password, not your login).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Bright Smile Clinic <you@gmail.com>

# --- Database (only when running outside Docker) ---
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
