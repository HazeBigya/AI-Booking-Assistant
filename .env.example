# Copy to .env and fill in. docker compose reads .env automatically.

# Priority chain, comma-separated — tries each in order, falls through on
# failure/rate-limit. Providers with missing keys are skipped. If ALL fail, the
# bot returns an honest "can't connect" message.
# Each entry is "provider" or "provider:model" (model may contain ':').
# Options: openai | deepseek | gemini | bedrock | openrouter
# Pick free models that SUPPORT TOOLS — verify current ones:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[] | select(.pricing.prompt=="0" and (.supported_parameters|index("tools"))) | .id'
LLM_PROVIDERS=deepseek,openrouter:z-ai/glm-5.2:free,openrouter:google/gemma-4-31b-it:free

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (used when LLM_PROVIDER=deepseek). Same OpenAI SDK, different endpoint.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Gemini (used when LLM_PROVIDER=gemini). Native @google/genai SDK.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter (used when LLM_PROVIDER=openrouter). One gateway to many models.
# Pick a model that supports tool-calling; ":free" variants exist.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Bedrock (used when LLM_PROVIDER=bedrock). Credentials come from the standard
# AWS chain (env/role) — no API key here. Verify the model id for your region:
#   aws bedrock list-inference-profiles --region <region>
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Secret for signing the session JWT. Use a long random string in production.
AUTH_SECRET=dev-only-insecure-secret-change-me

# Email (OTP + calendar invites). Transport precedence: SMTP -> Resend -> console.
# With none set, codes print to the server console (dev fallback).
# MAIL_FROM supports a display name: "Name <email>".

# SMTP (Gmail / Brevo / any host) — sends to arbitrary recipients, no domain
# needed. Gmail: enable 2FA, create an App Password, use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Bright Smile Clinic <you@gmail.com>

# Resend (used only if SMTP_HOST is unset). Needs a verified domain for
# arbitrary recipients; onboarding@resend.dev reaches only your own inbox.
RESEND_API_KEY=

# Only needed to run the app OUTSIDE docker (e.g. `npm run dev` on the host).
# Inside compose the app uses the db service hostname automatically.
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
