# Copy to .env and fill in.

# AI ─────────────────────────────────────────────────────────────────────────
# One provider, or several comma-separated as a failover chain in that order.
# anthropic | openai | gemini | deepseek | openrouter | custom
AI_PROVIDER=deepseek

# platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# platform.deepseek.com — cheapest
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-pro

# openrouter.ai/keys — one key, many vendors
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Any other OpenAI-compatible endpoint. Needs AI_PROVIDER=custom.
# CUSTOM_BASE_URL=https://your-endpoint/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=

# The model must support tool calling or nothing gets booked.

# VOICE ──────────────────────────────────────────────────────────────────────
# Two separate choices, because nobody hears the STT and everybody hears the
# TTS. Independent of AI_PROVIDER above: the chat vendor need not sell speech.
# Leave unset and the mic button stays disabled with a reason. There is
# deliberately no browser-speech fallback — it sounds like Google Translate.

# openai | deepgram | browser   (browser = free, Chrome only, no key)
VOICE_STT_PROVIDER=openai
# openai | elevenlabs | deepgram
VOICE_TTS_PROVIDER=openai

# Model ids drift between releases; override if a vendor renames one.
# VOICE_STT_MODEL=whisper-1
# VOICE_TTS_MODEL=gpt-4o-mini-tts
# VOICE_TTS_VOICE=alloy

# elevenlabs.io/app/settings/api-keys — best quality, roughly 10-20x the cost
# ELEVENLABS_API_KEY=
# console.deepgram.com — cheapest and fastest
# DEEPGRAM_API_KEY=

# Where recordings land. Relative paths resolve against the process's working
# directory, which is not the repo root under a production server — set an
# absolute path if you care where they go. Compose sets this already.
# VOICE_STORAGE_DIR=storage/voice

# CLINIC ─────────────────────────────────────────────────────────────────────
# Opening hours run on this clock. Blank = this machine's zone.
# e.g. Asia/Kathmandu, Asia/Taipei
CLINIC_TIMEZONE=

AUTH_SECRET=dev-only-insecure-secret-change-me

# Log each tool call's arguments and result. Off by default: those payloads
# carry the patient's login code, email and name. Even when on, those fields
# are redacted — this only makes the rest of the payload visible.
# DEBUG_TOOL_PAYLOADS=1

# EMAIL ──────────────────────────────────────────────────────────────────────
# Unset: codes and invites print to the log. MAIL_FROM must match SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=16-char-app-password
# MAIL_FROM=Bright Smile Clinic <you@gmail.com>
# RESEND_API_KEY=

# DATABASE ───────────────────────────────────────────────────────────────────
# Only for running outside Docker.
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
