# Copy to .env and fill in. docker compose reads .env automatically.

# Which LLM vendor to use: 'openai' or 'deepseek' (default: openai).
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (used when LLM_PROVIDER=deepseek). Same OpenAI SDK, different endpoint.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Bedrock (used when LLM_PROVIDER=bedrock). Credentials come from the standard
# AWS chain (env/role) — no API key here. Verify the model id for your region:
#   aws bedrock list-inference-profiles --region <region>
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Secret for signing the session JWT. Use a long random string in production.
AUTH_SECRET=dev-only-insecure-secret-change-me

# Only needed to run the app OUTSIDE docker (e.g. `npm run dev` on the host).
# Inside compose the app uses the db service hostname automatically.
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
